# ── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_token_here
DATABASE_URL=postgresql://meridian:password@localhost:5432/meridian
REDIS_URL=redis://localhost:6379/0
MERIDIAN_API_KEY=mer_test_replace_with_32_char_random_string_here

# ── Vector store ───────────────────────────────────────────────────────────────
VECTOR_STORE=pgvector
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=meridian
# PINECONE_ENVIRONMENT=us-east-1-aws

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
IVFFLAT_PROBES=10

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_BM25=20
RETRIEVAL_TOP_K_RERANK=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RETRIEVAL_CACHE_TTL=3600

# ── Pipeline ──────────────────────────────────────────────────────────────────
GROUNDEDNESS_THRESHOLD=0.80
MAX_SYNTHESIS_RETRIES=2
SYNTHESIS_MODEL=claude-sonnet-4-6
SYNTHESIS_MAX_TOKENS=4096
MAX_DOCUMENT_TOKENS=100000
CHUNK_SIZE_TARGET=512
CHUNK_OVERLAP=64

# ── Job management ────────────────────────────────────────────────────────────
JOB_TTL_DAYS=7
MAX_FILE_SIZE_MB=500
MAX_FILES_PER_JOB=10
CELERY_CONCURRENCY=4
CELERY_TASK_TIMEOUT=900
WEBHOOK_RETRY_DELAYS=30,90,270
# WEBHOOK_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/meridian
# GCS_UPLOADS_BUCKET=
# GCS_REPORTS_BUCKET=

# ── LLMOps (all optional in development) ─────────────────────────────────────
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=meridian
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=meridian-eval
# WANDB_API_KEY=
WANDB_PROJECT=meridian
# SENTRY_DSN=

# ── Corpus ────────────────────────────────────────────────────────────────────
CORPUS_SOURCES=gdpr,soc2,iso27001,sec_sp,cfpb
CORPUS_REFRESH_SCHEDULE=0 2 * * *
CORPUS_MAX_STALENESS_DAYS=30
EDGAR_USER_AGENT=Meridian/1.0 contact@example.com

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_FORMAT=text
WORKERS=1
PORT=8000
ALLOWED_ORIGINS=*
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
