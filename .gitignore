# ── ML / AI artefacts ────────────────────────────────────────────────────────
# Model weights (large files — store in GCS or HF Hub instead)
*.pt
*.pth
*.onnx
*.bin
*.safetensors
/models/
model_cache/
.cache/huggingface/
huggingface/

# MLflow artefacts (use remote tracking server in production)
mlruns/
mlartifacts/

# ── Storage / uploads ─────────────────────────────────────────────────────────
# Local storage (development only — never commit user-uploaded files)
/tmp/meridian/
uploads/
reports/
/data/uploads/
/data/reports/

# ── Corpus source files ───────────────────────────────────────────────────────
# Downloaded corpus files (large, regeneratable from ingestion script)
data/corpus_sources/*.pdf
data/corpus_sources/*.txt
data/corpus_sources/*.html
# Keep the directory and .gitkeep
!data/corpus_sources/.gitkeep

# ── Sample docs ───────────────────────────────────────────────────────────────
# Keep sample docs but exclude large test files
data/sample_docs/*.mp3
data/sample_docs/*.wav
data/sample_docs/*.m4a

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Docker ───────────────────────────────────────────────────────────────────
.docker/

# ── Alembic ──────────────────────────────────────────────────────────────────
# Keep all migration files — they are part of the codebase

# ── Profiling ────────────────────────────────────────────────────────────────
*.prof
profile.out
*.lprof
*.cprof

# ── Coverage ──────────────────────────────────────────────────────────────────
.coverage.*
!.coveragerc

# ── Pre-commit ────────────────────────────────────────────────────────────────
# Keep pre-commit config; ignore its cache
.pre-commit-cache/

# ── Ruff ──────────────────────────────────────────────────────────────────────
.ruff_cache/

